{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echoport",
  "version": "0.1.1",
  "identifier": "io.github.hkaaf.echoport",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Echoport",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "HKaaf",
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Share microphones and speakers between devices on your network",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Farsi"],
        "displayLanguageSelector": true
      }
    }
  }
}
